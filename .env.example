# ─── Django Core ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000
# In production, also set CSRF_TRUSTED_ORIGINS=https://your.domain
# and CREDENTIAL_ENCRYPTION_KEY=<32+ char random string>

# ─── Rate Limiting (DRF throttling) ────────────────────────────
THROTTLE_AUTH=30/min
THROTTLE_WEBCHAT=60/min
THROTTLE_WEBHOOK=600/min

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://openchat:openchat_dev_password@localhost:5432/openchat

# ─── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# ─── AI Providers ─────────────────────────────────────────────
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# ─── Meta (Facebook / Instagram) ──────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=openchat_webhook_verify

# ─── WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=openchat_whatsapp_verify
WHATSAPP_API_VERSION=v20.0

# ─── Shopify ──────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ─── WooCommerce ──────────────────────────────────────────────
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ─── Storage (S3 / R2) ────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
USE_S3=False

# ─── Email ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@openchat.local

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
